# SerpApi Google Shopping API key (get one at serpapi.com)
# SERPAPI_KEY=your_key_here

# NextAuth secret (generate with: openssl rand -base64 32)
# AUTH_SECRET=your_secret_here

# Optional: public site URL. Leave unset in local development — Auth.js v5
# beta derives the request origin from the incoming request. If you set it,
# include the auth base path (e.g. http://localhost:3000/api/auth).
# NEXTAUTH_URL=http://localhost:3000/api/auth